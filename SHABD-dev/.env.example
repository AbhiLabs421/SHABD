# SHABD — production environment template
#
# Copy this to `.env`, fill in real values, then `chmod 600 .env`.
# Never commit `.env` (it's gitignored).

# ---- REQUIRED ----------------------------------------------------------
# A 32+ byte secret used to sign tokens and the Grimoire audit chain.
# Generate one with:  openssl rand -hex 32
SHABD_SECRET=replace-me-with-32-or-more-random-bytes-please

# ---- OPTIONAL: secret rotation ----------------------------------------
# During a key rotation, set SHABD_SECRET_OLD to the previous secret so
# tokens issued before rotation keep verifying.
# SHABD_SECRET_OLD=previous-32-byte-secret

# ---- OPTIONAL: audit chain persistence --------------------------------
# Path to the on-disk JSONL log. Mount a persistent volume here.
SHABD_AUDIT=/var/lib/shabd/audit.jsonl

# ---- OPTIONAL: SIEM streaming -----------------------------------------
# Every Grimoire page is HMAC-signed and POSTed to this URL asynchronously.
# SIEM_URL=https://siem.example.com/ingest
# SIEM_SECRET=hmac-secret-shared-with-the-siem

# ---- OPTIONAL: server tuning ------------------------------------------
SHABD_LOG_LEVEL=INFO
# SHABD_PORT=8765
# SHABD_HOST=0.0.0.0
